{
  "name": "JSRunner",
  "params": {
    "jsPath": "js/smAgent.js",
    "jobParams": {
      "repo": "epam/dmtools-dart",
      "maxTriggeredWorkflows": 1,
      "rules": [
        {
          "description": "Every open non-draft PR behind main gets a silent branch refresh with the workflow token (pushes trigger no workflows, so freshness is free); validating PRs are excluded so the validation head never moves mid-run. mergeState matches BEHIND or BLOCKED — REST mergeable_state flip-flops between the two for the same behind PR under branch protection, and gh pr update-branch is a no-op on a fresh branch, so over-matching is harmless. Replaces the retired auto-update-prs workflow.",
          "source": "github",
          "query": {
            "type": "pr",
            "notLabels": [
              "ai_validating"
            ],
            "mergeState": [
              "BEHIND",
              "BLOCKED"
            ],
            "draft": false
          },
          "localAction": "update_branch",
          "limit": 5,
          "id": "silent-update-behind"
        },
        {
          "description": "GitHub PR: merge window — oldest armed PR gets a PAT update (validation CI fires on the final head) + ai_validating marker (#687)",
          "source": "github",
          "query": {
            "type": "pr",
            "labels": [
              "pr_approved"
            ],
            "notLabels": [
              "ai_validating"
            ],
            "notMergeState": "BEHIND",
            "draft": false
          },
          "localAction": "validate_pr",
          "limit": 1,
          "id": "validate-armed"
        },
        {
          "description": "GitHub PR: validation CI red on the final head -> unarm, report, requeue agent:rework on the linked issue (#687). NB: labels are OR-matched; ai_validating only ever lands on armed (pr_approved) PRs.",
          "source": "github",
          "query": {
            "type": "pr",
            "labels": [
              "ai_validating"
            ],
            "checks": "red"
          },
          "localAction": "fail_validation",
          "limit": 1,
          "id": "fail-validation"
        },
        {
          "description": "GitHub PR: validation green + CLEAN -> squash-merge, clear markers (FIFO drain, #687). NB: labels are OR-matched; ai_validating implies armed (pr_approved).",
          "source": "github",
          "query": {
            "type": "pr",
            "labels": [
              "ai_validating"
            ],
            "checks": "green",
            "mergeState": "CLEAN"
          },
          "localAction": "merge_pr",
          "limit": 1,
          "id": "merge-validated"
        },
        {
          "description": "GitHub: red CI on linked PR → rework (dead-letter re-fire)",
          "source": "github",
          "query": {
            "type": "issue",
            "labels": [
              "agent:rework"
            ],
            "prChecks": "red"
          },
          "workflowFile": "ai-teammate.yml",
          "inputs": {
            "issue": "{issueNumber}",
            "leg": "rework",
            "reason": "sm: red CI on linked PR"
          },
          "limit": 1,
          "id": "rework-on-red-ci"
        },
        {
          "description": "GitHub: green PR after dev → machine review",
          "source": "github",
          "query": {
            "type": "issue",
            "labels": [
              "ai_developed"
            ],
            "notLabels": [
              "ai_pr_reviewed",
              "agent:rework"
            ],
            "prChecks": "green"
          },
          "workflowFile": "ai-teammate.yml",
          "inputs": {
            "issue": "{issueNumber}",
            "leg": "review",
            "reason": "sm: green PR awaits review"
          },
          "limit": 1,
          "id": "review-after-dev"
        },
        {
          "description": "GitHub PR: external (non-machine) green PR -> one-time review (PR-anchored; no re-review on later pushes). The machine login is deployment-specific: it arrives via jobParams.machineAuthor / config.machineAuthor (factory-sm input machine-author); with none configured every green PR is reviewable.",
          "source": "github",
          "query": {
            "type": "pr",
            "notLabels": [
              "ai_pr_reviewed",
              "agent:review"
            ],
            "checks": "green",
            "draft": false,
            "notMachine": true
          },
          "workflowFile": "ai-teammate.yml",
          "inputs": {
            "issue": "",
            "leg": "review",
            "reason": "sm: external PR green - one-time review",
            "pr": "{prNumber}"
          },
          "limit": 1,
          "id": "review-external-once"
        },
        {
          "description": "GitHub PR: agent:review label on a PR -> review on demand (any author; consumed by the review runner)",
          "source": "github",
          "query": {
            "type": "pr",
            "labels": [
              "agent:review"
            ]
          },
          "workflowFile": "ai-teammate.yml",
          "inputs": {
            "issue": "",
            "leg": "review",
            "reason": "sm: agent:review label on PR",
            "pr": "{prNumber}"
          },
          "limit": 1,
          "id": "review-on-label"
        },
        {
          "description": "GitHub: linked PR merged → close the issue (cycle complete)",
          "source": "github",
          "query": {
            "type": "issue",
            "labels": [
              "ai_developed"
            ],
            "prState": "MERGED"
          },
          "localAction": "close_issue",
          "limit": 5,
          "id": "close-on-merge"
        }
      ]
    }
  }
}
