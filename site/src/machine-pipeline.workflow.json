{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Machine Delivery Pipeline — GitHub loop (dmtools-agents factory)",
    "output": "site/machine-pipeline.html",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "trigger",
      "label": "Trigger (human)"
    },
    {
      "id": "agent",
      "label": "ai-teammate legs"
    },
    {
      "id": "sm",
      "label": "Machine SM rules"
    },
    {
      "id": "window",
      "label": "Merge window → outcome"
    }
  ],
  "phases": [
    {
      "id": "trigger",
      "label": "1 · Trigger",
      "fromCol": 0,
      "toCol": 1
    },
    {
      "id": "build",
      "label": "2 · Develop · validate · rework",
      "fromCol": 2,
      "toCol": 3,
      "variant": "emphasis"
    },
    {
      "id": "window",
      "label": "3 · Review → approved → merge",
      "fromCol": 4,
      "toCol": 5,
      "variant": "dashed"
    }
  ],
  "mainPath": [
    "issue",
    "assigned",
    "teammate",
    "development",
    "pr",
    "vfresh",
    "review",
    "varmed",
    "merged"
  ],
  "nodes": [
    {
      "id": "issue",
      "lane": "trigger",
      "col": 0,
      "type": "external",
      "label": "Issue created",
      "sublabel": "by a human"
    },
    {
      "id": "assigned",
      "lane": "trigger",
      "col": 1,
      "type": "security",
      "label": "Assigned to ai-teammate",
      "sublabel": "assignee gate",
      "tag": "sole auto-trigger",
      "width": 166
    },
    {
      "id": "teammate",
      "lane": "agent",
      "col": 1,
      "type": "backend",
      "label": "ai-teammate.yml",
      "sublabel": "dev leg dispatched",
      "tag": "label agent:dev",
      "width": 116
    },
    {
      "id": "development",
      "lane": "agent",
      "col": 2,
      "type": "backend",
      "label": "Development",
      "sublabel": "branch ai/gh-N",
      "tag": "CI silent on push",
      "width": 100
    },
    {
      "id": "pr",
      "lane": "agent",
      "col": 3,
      "type": "frontend",
      "label": "PR head",
      "sublabel": "no verdict yet",
      "width": 84
    },
    {
      "id": "review",
      "lane": "sm",
      "col": 4,
      "type": "backend",
      "label": "AI review",
      "sublabel": "review-after-dev leg",
      "tag": "ai_pr_reviewed · changes → rework",
      "width": 150
    },
    {
      "id": "vfresh",
      "lane": "sm",
      "col": 3,
      "type": "security",
      "label": "validate-fresh",
      "sublabel": "checks none|pending",
      "tag": "arm ai_validating + CI",
      "width": 100
    },
    {
      "id": "varmed",
      "lane": "sm",
      "col": 5,
      "type": "security",
      "label": "validate-armed",
      "sublabel": "approved · not armed",
      "tag": "mutex · oldest first",
      "width": 104
    },
    {
      "id": "rework",
      "lane": "sm",
      "col": 2,
      "type": "messagebus",
      "label": "Rework",
      "sublabel": "agent:rework leg · fixes",
      "tag": "CI red · review changes · sticky approval",
      "width": 160
    },
    {
      "id": "merged",
      "lane": "window",
      "col": 5,
      "type": "security",
      "label": "Merged",
      "sublabel": "green + CLEAN",
      "tag": "squash · issue closed",
      "width": 110
    }
  ],
  "edges": [
    {
      "from": "issue",
      "to": "assigned"
    },
    {
      "from": "assigned",
      "to": "teammate",
      "label": "assign event",
      "variant": "emphasis",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "teammate",
      "to": "development"
    },
    {
      "from": "development",
      "to": "pr"
    },
    {
      "from": "pr",
      "to": "vfresh",
      "label": "SM tick"
    },
    {
      "from": "vfresh",
      "to": "review",
      "label": "green → latch ai_validated",
      "variant": "emphasis"
    },
    {
      "from": "vfresh",
      "to": "rework",
      "label": "red → fail-validation",
      "variant": "security",
      "role": "error"
    },
    {
      "from": "review",
      "to": "varmed",
      "label": "APPROVE → pr_approved",
      "variant": "emphasis"
    },
    {
      "from": "varmed",
      "to": "merged",
      "label": "green + CLEAN"
    },
    {
      "from": "rework",
      "to": "development",
      "label": "new pushes",
      "variant": "dashed",
      "role": "return"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Rule labels",
      "items": [
        "agent:dev / agent:rework — agent legs; ai_validating — armed (mutex)",
        "ai_validated → ai_pr_reviewed → pr_approved — latch · review · sticky OK"
      ]
    },
    {
      "dot": "emerald",
      "title": "Status observation",
      "items": [
        "Rollup green/red/pending/none (CANCELLED = no verdict) · mergeState CLEAN/BEHIND/DIRTY/BLOCKED",
        "BEHIND: unarm → silent update → re-arm · dead zones closed in #527"
      ]
    }
  ]
}