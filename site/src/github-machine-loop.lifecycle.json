{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "dmtools-agents — GitHub Machine Loop (SM owns every transition)",
    "output": "site/index.html",
    "viewBox": [
      980,
      630
    ],
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "main",
      "label": "Dev lane — parallel, non-blocking"
    },
    {
      "id": "events",
      "label": "Rework loop · merge window (FIFO, mutex) — SM tick ×10 dials drive every transition"
    },
    {
      "id": "terminal",
      "label": "Outcome"
    }
  ],
  "states": [
    {
      "id": "assigned",
      "type": "start",
      "label": "Assigned",
      "sublabel": "issue → ai-teammate",
      "lane": "main",
      "col": 0,
      "step": "01",
      "tag": "sole auto-trigger"
    },
    {
      "id": "developing",
      "type": "active",
      "label": "Development",
      "sublabel": "dev leg · free pushes",
      "lane": "main",
      "col": 1,
      "step": "02",
      "tag": "CI silent on push"
    },
    {
      "id": "validating",
      "type": "active",
      "label": "Validating",
      "sublabel": "SM-dispatched CI",
      "lane": "main",
      "col": 2,
      "step": "03",
      "tag": "validate-fresh ×5"
    },
    {
      "id": "in_review",
      "type": "waiting",
      "label": "In Review",
      "sublabel": "review on PR head",
      "lane": "main",
      "col": 3,
      "step": "04",
      "tag": "review ×10"
    },
    {
      "id": "rework",
      "type": "active",
      "label": "Rework",
      "sublabel": "fixes · CI silent",
      "lane": "events",
      "col": 0,
      "tag": "agent:rework"
    },
    {
      "id": "escalated",
      "type": "failure",
      "label": "Escalated",
      "sublabel": "human takes over",
      "lane": "events",
      "col": 0,
      "tag": "round cap",
      "yOffset": 98
    },
    {
      "id": "approved",
      "type": "active",
      "label": "Approved",
      "sublabel": "FIFO queue",
      "lane": "events",
      "col": 2,
      "step": "05",
      "tag": "oldest first"
    },
    {
      "id": "merged",
      "type": "success",
      "label": "Merged",
      "sublabel": "squash · cleaned",
      "lane": "terminal",
      "col": 1,
      "step": "06",
      "tag": "green + CLEAN"
    }
  ],
  "transitions": [
    {
      "from": "assigned",
      "to": "developing"
    },
    {
      "from": "developing",
      "to": "validating"
    },
    {
      "from": "validating",
      "to": "in_review",
      "route": "straight"
    },
    {
      "from": "in_review",
      "to": "approved",
      "variant": "dashed"
    },
    {
      "from": "approved",
      "to": "merged"
    },
    {
      "from": "validating",
      "to": "rework",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "top"
    },
    {
      "from": "rework",
      "to": "validating",
      "route": "left-channel",
      "channelX": 320
    },
    {
      "from": "in_review",
      "to": "rework",
      "variant": "security",
      "fromSide": "bottom",
      "toSide": "right"
    },
    {
      "from": "rework",
      "to": "escalated",
      "variant": "security"
    }
  ]
}