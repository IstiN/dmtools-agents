{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Factory Flow — four levels of the dmtools-agents machine loop",
    "output": "site/index.html",
    "quality_profile": "standard"
  },
  "lanes": [
    {
      "id": "l1",
      "label": "01 · Level 1 — Issue → Development"
    },
    {
      "id": "lt",
      "label": "⚡ External triggers (outside the machine)"
    },
    {
      "id": "l2",
      "label": "02 · Level 2 — Development loop (review ↔ rework + fail path)"
    },
    {
      "id": "l3",
      "label": "03 · Level 3 — Validation (mutex ai_validating)"
    },
    {
      "id": "l4",
      "label": "04 · Level 4 — Merged (terminal)"
    }
  ],
  "mainPath": [
    "issue",
    "devleg",
    "pr",
    "vfresh"
  ],
  "nodes": [
    {
      "id": "issue",
      "lane": "l1",
      "col": 0,
      "type": "external",
      "label": "New issue",
      "sublabel": "→ dev handoff",
      "tag": "SEE: issue open · fresh",
      "width": 120
    },
    {
      "id": "devleg",
      "lane": "l1",
      "col": 1,
      "type": "backend",
      "label": "Dev leg",
      "sublabel": "leg=dev · guard",
      "tag": "SEE: dev run active",
      "width": 120
    },
    {
      "id": "pr",
      "lane": "l1",
      "col": 2,
      "type": "frontend",
      "label": "PR opened",
      "sublabel": "body Closes #N",
      "tag": "SEE: ai_developed",
      "width": 120
    },
    {
      "id": "manual",
      "lane": "lt",
      "col": 0,
      "type": "external",
      "label": "Manual rework",
      "sublabel": "human +agent:rework",
      "tag": "SEE: rework-on-label",
      "width": 120
    },
    {
      "id": "reworkleg",
      "lane": "l2",
      "col": 2,
      "type": "messagebus",
      "label": "Rework leg",
      "sublabel": "leg=rework",
      "tag": "SEE: agent:rework",
      "width": 120
    },
    {
      "id": "reviewleg",
      "lane": "l2",
      "col": 3,
      "type": "backend",
      "label": "Review leg",
      "sublabel": "pr_review.json",
      "tag": "SEE: agent:review",
      "width": 120
    },
    {
      "id": "vfresh",
      "lane": "l3",
      "col": 3,
      "type": "security",
      "label": "validate-fresh",
      "sublabel": "checks pending",
      "tag": "SEE: ai_validating",
      "width": 120
    },
    {
      "id": "varmed",
      "lane": "l3",
      "col": 4,
      "type": "security",
      "label": "validate-armed",
      "sublabel": "pr_approved mutex",
      "tag": "SEE: armed · approved",
      "width": 120
    },
    {
      "id": "failval",
      "lane": "l2",
      "col": 4,
      "type": "security",
      "label": "fail-validation",
      "sublabel": "red → unarm",
      "tag": "SEE: red · rework loop",
      "width": 120
    },
    {
      "id": "merged",
      "lane": "l4",
      "col": 4,
      "type": "backend",
      "label": "Merged",
      "sublabel": "merge_pr squash",
      "tag": "SEE: MERGED",
      "width": 120
    },
    {
      "id": "conflict",
      "lane": "l3",
      "col": 5,
      "type": "messagebus",
      "label": "conflict-rework",
      "sublabel": "DIRTY owner",
      "tag": "SEE: DIRTY",
      "width": 120
    },
    {
      "id": "crverdict",
      "label": "CR verdict",
      "sublabel": "review-verdict.sh",
      "lane": "lt",
      "type": "external",
      "tag": "SEE: verdict CR",
      "col": 1,
      "width": 120
    },
    {
      "id": "cisig",
      "label": "Red CI · DIRTY",
      "sublabel": "checks red · DIRTY",
      "lane": "lt",
      "type": "external",
      "tag": "SEE: red · DIRTY",
      "col": 4,
      "width": 120
    }
  ],
  "edges": [
    {
      "from": "issue",
      "to": "devleg"
    },
    {
      "from": "devleg",
      "to": "pr"
    },
    {
      "from": "pr",
      "to": "vfresh",
      "label": "SM tick · validate-fresh"
    },
    {
      "from": "vfresh",
      "to": "reviewleg",
      "label": "green → +ai_validated · review-after-dev",
      "variant": "emphasis"
    },
    {
      "from": "reviewleg",
      "to": "varmed",
      "label": "APPROVE + green checks → +pr_approved → validate-armed (mutex free)",
      "variant": "emphasis"
    },
    {
      "from": "manual",
      "to": "reworkleg"
    },
    {
      "from": "varmed",
      "to": "merged",
      "label": "green + CLEAN → merge_pr",
      "variant": "emphasis"
    },
    {
      "from": "crverdict",
      "to": "reworkleg",
      "label": "+agent:rework · prMachineAuthor only (guests: HUMAN)"
    },
    {
      "from": "cisig",
      "to": "failval",
      "label": "red → fail-validation · unarm ai_validating"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Gate guards — Levels 1–2 (full blocking conditions)",
      "items": [
        "dev leg: issue OPEN · ¬agent:skip · assignee ai-teammate or agent:dev · fresh handoff only (no status labels yet)",
        "review-after-dev: ai_developed + ai_validated · ¬ai_pr_reviewed ¬pr_approved · re-review: ai_pr_reviewed + green + ALL threads resolved + stale verdict · ¬agent:review ¬ai_validating ¬pr_approved"
      ]
    },
    {
      "dot": "amber",
      "title": "Gate guards — Levels 3–4 (full blocking conditions)",
      "items": [
        "validate-fresh: checks none|pending · ¬ai_validating ¬pr_approved ¬ai_validated ¬BEHIND · validate-armed: pr_approved + mutex ai_validating free (FIFO oldest) · ¬BEHIND",
        "merge-validated: green + CLEAN · fail-validation: red (CANCELLED = no verdict) · conflict-rework: DIRTY · close-on-merge: ai_developed + issue OPEN · stalls: factory-stalls.html"
      ]
    }
  ]
}