{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Factory Flow — four levels of the dmtools-agents machine loop",
    "output": "site/index.html",
    "quality_profile": "standard"
  },
  "lanes": [
    {
      "id": "l1",
      "label": "01 · Level 1 — Issue → Development"
    },
    {
      "id": "lt",
      "label": "⚡ External triggers (outside the machine)"
    },
    {
      "id": "l2",
      "label": "02 · Level 2 — Development loop (review ↔ rework + fail path)"
    },
    {
      "id": "l3",
      "label": "03 · Level 3 — Validation (mutex ai_validating)"
    },
    {
      "id": "l4",
      "label": "04 · Level 4 — Merged (terminal)"
    }
  ],
  "mainPath": [
    "issue",
    "devleg",
    "pr",
    "vfresh"
  ],
  "nodes": [
    {
      "id": "issue",
      "lane": "l1",
      "col": 0,
      "type": "external",
      "label": "New issue",
      "sublabel": "assignee ai-teammate · label agent:dev",
      "tag": "SEE: issue OPEN · no status labels",
      "width": 240
    },
    {
      "id": "devleg",
      "lane": "l1",
      "col": 1,
      "type": "backend",
      "label": "Dev leg",
      "sublabel": "factory-teammate.yml leg=dev · story|bug_development.json",
      "tag": "SEE: dev run in_progress",
      "width": 240
    },
    {
      "id": "pr",
      "lane": "l1",
      "col": 3,
      "type": "frontend",
      "label": "PR opened",
      "sublabel": "developTicketAndCreatePR.js · +ai_developed · body Closes #N",
      "tag": "SEE: PR open · no ai_* labels",
      "width": 240
    },
    {
      "id": "manual",
      "lane": "lt",
      "col": 0,
      "type": "external",
      "label": "Manual rework",
      "sublabel": "human labels PR agent:rework",
      "tag": "SEE: agent:rework set by human",
      "width": 240
    },
    {
      "id": "crverdict",
      "lane": "lt",
      "col": 2,
      "type": "external",
      "label": "CR verdict",
      "sublabel": "review-verdict.sh = CHANGES_REQUESTED",
      "tag": "SEE: ai_pr_reviewed · verdict CR",
      "width": 240
    },
    {
      "id": "cisig",
      "lane": "lt",
      "col": 5,
      "type": "external",
      "label": "Red CI · DIRTY",
      "sublabel": "checks red · mergeState DIRTY",
      "tag": "SEE: red checks · DIRTY on PR",
      "width": 240
    },
    {
      "id": "reworkleg",
      "lane": "l2",
      "col": 1,
      "type": "messagebus",
      "label": "Rework leg",
      "sublabel": "leg=rework · pr_rework.json · pushReworkChanges.js",
      "tag": "SEE: agent:rework consumed",
      "width": 240
    },
    {
      "id": "reviewleg",
      "lane": "l2",
      "col": 4,
      "type": "backend",
      "label": "Review leg",
      "sublabel": "leg=review · pr_review.json · +ai_pr_reviewed",
      "tag": "SEE: agent:review armed",
      "width": 240
    },
    {
      "id": "failval",
      "lane": "l2",
      "col": 5,
      "type": "security",
      "label": "fail-validation",
      "sublabel": "fail_validation · unarm ai_validating · red report",
      "tag": "SEE: checks red · arm cleared",
      "width": 240
    },
    {
      "id": "vfresh",
      "lane": "l3",
      "col": 3,
      "type": "messagebus",
      "label": "validate-fresh",
      "sublabel": "validate_pr dispatches CI · +ai_validating",
      "tag": "SEE: ai_validating · checks pending",
      "width": 240
    },
    {
      "id": "conflict",
      "lane": "l3",
      "col": 4,
      "type": "messagebus",
      "label": "conflict-rework",
      "sublabel": "conflict_rework owns DIRTY · update_branch excluded",
      "tag": "SEE: mergeState DIRTY",
      "width": 240
    },
    {
      "id": "varmed",
      "lane": "l3",
      "col": 5,
      "type": "security",
      "label": "validate-armed",
      "sublabel": "mutex ai_validating FIFO · validate_pr on PR head",
      "tag": "SEE: pr_approved + ai_validating",
      "width": 240
    },
    {
      "id": "merged",
      "lane": "l4",
      "col": 5,
      "type": "backend",
      "label": "Merged",
      "sublabel": "merge_pr squash → close-on-merge · close_issue",
      "tag": "SEE: PR MERGED · issue closed",
      "width": 240
    }
  ],
  "edges": [
    {
      "from": "issue",
      "to": "devleg",
      "label": "guard: OPEN · ai-teammate | agent:dev"
    },
    {
      "from": "devleg",
      "to": "pr",
      "label": "developTicketAndCreatePR.js → +ai_developed"
    },
    {
      "from": "pr",
      "to": "vfresh",
      "label": "checks none|pending → validate-fresh"
    },
    {
      "from": "vfresh",
      "to": "reviewleg",
      "label": "green → +ai_validated · review-after-dev"
    },
    {
      "from": "reviewleg",
      "to": "varmed",
      "label": "APPROVE + green → +pr_approved"
    },
    {
      "from": "varmed",
      "to": "merged",
      "label": "green + CLEAN → merge_pr squash"
    },
    {
      "from": "manual",
      "to": "reworkleg",
      "label": "human label → rework-on-label"
    },
    {
      "from": "crverdict",
      "to": "reworkleg",
      "label": "verdict CR fires rework"
    },
    {
      "from": "cisig",
      "to": "failval",
      "label": "checks red → fail_validation · unarm",
      "role": "error"
    },
    {
      "from": "cisig",
      "to": "conflict",
      "label": "DIRTY → conflict_rework",
      "role": "error"
    },
    {
      "from": "reviewleg",
      "to": "reworkleg",
      "label": "CHANGES_REQUESTED → +agent:rework (machine authors)",
      "role": "error"
    },
    {
      "from": "failval",
      "to": "reworkleg",
      "label": "+agent:rework (machine PRs)",
      "role": "error"
    },
    {
      "from": "conflict",
      "to": "reworkleg",
      "label": "+agent:rework (machine) · HUMAN (guest)",
      "role": "error"
    },
    {
      "from": "reworkleg",
      "to": "reviewleg",
      "label": "threads resolved + green + stale verdict → re-review (review-threads-resolved)",
      "fromSide": "bottom",
      "toSide": "bottom",
      "via": [
        [
          436,
          438
        ],
        [
          952,
          438
        ]
      ]
    },
    {
      "from": "reworkleg",
      "to": "vfresh",
      "label": "push → new head · checks none → re-dispatch"
    },
    {
      "from": "varmed",
      "to": "failval",
      "label": "checks red (armed) → fail_validation · unarm",
      "role": "error"
    },
    {
      "from": "vfresh",
      "to": "failval",
      "label": "checks red → fail_validation · unarm",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Gate guards — Levels 1–2 (full blocking conditions)",
      "items": [
        "dev leg: issue OPEN · ¬agent:skip · assignee ai-teammate or agent:dev · fresh handoff only (no status labels yet)",
        "review-after-dev: ai_developed + ai_validated · ¬ai_pr_reviewed ¬pr_approved · re-review: ai_pr_reviewed + green + ALL threads resolved + stale verdict · ¬agent:review ¬ai_validating ¬pr_approved"
      ]
    },
    {
      "dot": "amber",
      "title": "Gate guards — Levels 3–4 (full blocking conditions)",
      "items": [
        "validate-fresh: checks none|pending · ¬ai_validating ¬pr_approved ¬ai_validated ¬BEHIND · validate-armed: pr_approved + mutex ai_validating free (FIFO oldest) · ¬BEHIND",
        "merge-validated: green + CLEAN · fail-validation: red (CANCELLED = no verdict) · conflict-rework: DIRTY · close-on-merge: ai_developed + issue OPEN · stalls: factory-stalls.html"
      ]
    }
  ]
}