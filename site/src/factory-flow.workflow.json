{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Factory Flow — four levels of the dmtools-agents machine loop",
    "output": "site/index.html",
    "quality_profile": "showcase"
  },
  "lanes": [
    {
      "id": "l1",
      "label": "01 · Level 1 — Issue → Development"
    },
    {
      "id": "l2",
      "label": "02 · Level 2 — Development loop (PR ↔ review ↔ rework)"
    },
    {
      "id": "l3",
      "label": "03 · Level 3 — Validation (mutex ai_validating)"
    },
    {
      "id": "l4",
      "label": "04 · Level 4 — Merged (terminal)"
    }
  ],
  "mainPath": [
    "issue",
    "devleg",
    "pr",
    "vfresh"
  ],
  "nodes": [
    {
      "id": "issue",
      "lane": "l1",
      "col": 0,
      "type": "external",
      "label": "New issue → handoff",
      "sublabel": "assign ai-teammate · label agent:dev",
      "tag": "SEE: issue open · no status labels yet",
      "width": 175
    },
    {
      "id": "devleg",
      "lane": "l1",
      "col": 1,
      "type": "backend",
      "label": "Dev leg",
      "sublabel": "factory-teammate.yml · guard → dev",
      "tag": "SEE: dev workflow run in_progress",
      "width": 195
    },
    {
      "id": "pr",
      "lane": "l1",
      "col": 4,
      "type": "frontend",
      "label": "PR opened",
      "sublabel": "body Closes #N · head branch",
      "tag": "SEE: issue ai_developed · PR no ai_* labels",
      "width": 185
    },
    {
      "id": "manual",
      "lane": "l2",
      "col": 0,
      "type": "external",
      "label": "Manual rework",
      "sublabel": "human labels PR agent:rework",
      "tag": "SEE: agent:rework set by a human",
      "width": 140
    },
    {
      "id": "reworkleg",
      "lane": "l2",
      "col": 1,
      "type": "messagebus",
      "label": "Rework leg",
      "sublabel": "leg=rework · pr_rework.json",
      "tag": "SEE: agent:rework · pushReworkChanges.js → PR head",
      "width": 215
    },
    {
      "id": "reviewleg",
      "lane": "l2",
      "col": 3,
      "type": "backend",
      "label": "Review leg + verdict",
      "sublabel": "leg=review · pr_review.json · review-verdict.sh",
      "tag": "SEE: agent:review + ai_validated on PR",
      "width": 220
    },
    {
      "id": "vfresh",
      "lane": "l3",
      "col": 5,
      "type": "security",
      "label": "validate-fresh",
      "sublabel": "checks none|pending · red→failval",
      "tag": "SEE: ai_validating · checks pending",
      "width": 185
    },
    {
      "id": "varmed",
      "lane": "l3",
      "col": 4,
      "type": "security",
      "label": "validate-armed",
      "sublabel": "pr_approved · mutex ai_validating",
      "tag": "SEE: pr_approved + ai_validating · red→failval",
      "width": 185
    },
    {
      "id": "failval",
      "lane": "l3",
      "col": 0,
      "type": "security",
      "label": "fail-validation",
      "sublabel": "checks red → unarm ai_validating",
      "tag": "SEE: checks red · arm cleared",
      "width": 175
    },
    {
      "id": "merged",
      "lane": "l4",
      "col": 4,
      "type": "security",
      "label": "Merged",
      "sublabel": "merge_pr squash · -ai_validating",
      "tag": "SEE: PR MERGED · issue closed",
      "width": 175
    },
    {
      "id": "conflict",
      "lane": "l3",
      "col": 3,
      "type": "messagebus",
      "label": "conflict-rework",
      "sublabel": "DIRTY → conflict_rework",
      "tag": "SEE: mergeState DIRTY on the PR",
      "width": 170
    }
  ],
  "edges": [
    {
      "from": "issue",
      "to": "devleg"
    },
    {
      "from": "devleg",
      "to": "pr"
    },
    {
      "from": "pr",
      "to": "vfresh",
      "label": "SM tick · validate-fresh"
    },
    {
      "from": "vfresh",
      "to": "reviewleg",
      "label": "green → +ai_validated · review-after-dev",
      "variant": "emphasis"
    },
    {
      "from": "reviewleg",
      "to": "varmed",
      "label": "APPROVE + green checks → +pr_approved → validate-armed (mutex free)",
      "variant": "emphasis"
    },
    {
      "from": "vfresh",
      "to": "varmed",
      "label": "pr_approved latch → armed re-validation"
    },
    {
      "from": "manual",
      "to": "reworkleg"
    },
    {
      "from": "reviewleg",
      "to": "reworkleg",
      "label": "CHANGES_REQUESTED → +agent:rework (machine authors only)",
      "variant": "security",
      "role": "error"
    },
    {
      "from": "failval",
      "to": "reworkleg",
      "label": "+agent:rework · rework-on-red-ci (prMachineAuthor only)",
      "variant": "security",
      "role": "error"
    },
    {
      "from": "varmed",
      "to": "merged",
      "label": "green + CLEAN → merge_pr",
      "variant": "emphasis"
    },
    {
      "from": "conflict",
      "to": "reworkleg",
      "variant": "security"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Gate guards — Levels 1–2 (full blocking conditions)",
      "items": [
        "dev leg: issue OPEN · ¬agent:skip · assignee ai-teammate or agent:dev · fresh handoff only (no status labels yet)",
        "review-after-dev: ai_developed + ai_validated · ¬ai_pr_reviewed ¬pr_approved · re-review: ai_pr_reviewed + green + ALL threads resolved + stale verdict · ¬agent:review ¬ai_validating ¬pr_approved"
      ]
    },
    {
      "dot": "amber",
      "title": "Gate guards — Levels 3–4 (full blocking conditions)",
      "items": [
        "validate-fresh: checks none|pending · ¬ai_validating ¬pr_approved ¬ai_validated ¬BEHIND · validate-armed: pr_approved + mutex ai_validating free (FIFO oldest) · ¬BEHIND",
        "merge-validated: green + CLEAN · fail-validation: red (CANCELLED = no verdict) · conflict-rework: DIRTY · close-on-merge: ai_developed + issue OPEN · stalls: factory-stalls.html"
      ]
    }
  ]
}