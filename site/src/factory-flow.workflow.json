{
  "schema_version": 2,
  "diagram_type": "workflow",
  "meta": {
    "title": "Factory Flow \u2014 four levels of the dmtools-agents machine loop",
    "output": "site/index.html",
    "quality_profile": "standard"
  },
  "lanes": [
    {
      "id": "l1",
      "label": "01 \u00b7 Level 1 \u2014 Issue \u2192 Development"
    },
    {
      "id": "lt",
      "label": "\u26a1 External triggers (outside the machine)"
    },
    {
      "id": "l2",
      "label": "02 \u00b7 Level 2 \u2014 Development loop (review \u2194 rework + fail path)"
    },
    {
      "id": "l3",
      "label": "03 \u00b7 Level 3 \u2014 Validation (mutex ai_validating)"
    },
    {
      "id": "l4",
      "label": "04 \u00b7 Level 4 \u2014 Merged (terminal)"
    }
  ],
  "mainPath": [
    "issue",
    "devleg",
    "pr"
  ],
  "nodes": [
    {
      "id": "issue",
      "lane": "l1",
      "col": 0,
      "type": "external",
      "label": "New issue",
      "tag": "SEE: issue OPEN \u00b7 fresh",
      "width": 212
    },
    {
      "id": "devleg",
      "lane": "l1",
      "col": 1,
      "type": "backend",
      "label": "Dev leg",
      "sublabel": "leg=dev \u00b7 development.json",
      "tag": "SEE: dev run in_progress",
      "width": 236
    },
    {
      "id": "pr",
      "lane": "l1",
      "col": 2,
      "type": "frontend",
      "label": "PR opened",
      "sublabel": "developTicketAndCreatePR.js \u00b7 +ai_developed",
      "tag": "SEE: PR \u00b7 no ai_* labels",
      "width": 250
    },
    {
      "id": "manual",
      "lane": "lt",
      "col": 0,
      "type": "external",
      "label": "Manual rework",
      "sublabel": "human labels agent:rework",
      "tag": "SEE: rework-on-label",
      "width": 171
    },
    {
      "id": "reworkleg",
      "lane": "l2",
      "col": 1,
      "type": "messagebus",
      "label": "Rework leg",
      "sublabel": "leg=rework \u00b7 pr_rework.json \u00b7 pushReworkChanges.js",
      "tag": "SEE: agent:rework",
      "width": 250,
      "yOffset": -22
    },
    {
      "id": "reviewleg",
      "lane": "l2",
      "col": 3,
      "type": "backend",
      "label": "Review leg",
      "sublabel": "leg=review \u00b7 pr_review.json \u00b7 +ai_pr_reviewed",
      "tag": "SEE: agent:review",
      "width": 250,
      "yOffset": 0
    },
    {
      "id": "vfresh",
      "lane": "l3",
      "col": 3,
      "type": "messagebus",
      "label": "validate-fresh",
      "sublabel": "validate_pr \u00b7 +ai_validating",
      "tag": "SEE: checks pending",
      "width": 189,
      "yOffset": -30
    },
    {
      "id": "varmed",
      "lane": "l3",
      "col": 4,
      "type": "messagebus",
      "label": "validate-armed",
      "sublabel": "mutex ai_validating FIFO \u00b7 validate_pr",
      "tag": "SEE: pr_approved armed",
      "width": 248,
      "yOffset": 4
    },
    {
      "id": "failval",
      "lane": "l2",
      "col": 4,
      "type": "security",
      "label": "fail-validation",
      "sublabel": "fail_validation \u00b7 unarm ai_validating",
      "tag": "SEE: checks red",
      "width": 242,
      "yOffset": 22
    },
    {
      "id": "merged",
      "lane": "l4",
      "col": 4,
      "type": "backend",
      "label": "Merged",
      "sublabel": "merge_pr squash \u2192 close_issue",
      "tag": "SEE: MERGED",
      "width": 195
    },
    {
      "id": "conflict",
      "lane": "l3",
      "col": 1,
      "type": "messagebus",
      "label": "conflict-rework",
      "sublabel": "conflict_rework \u00b7 DIRTY owner",
      "tag": "SEE: mergeState DIRTY",
      "width": 195,
      "yOffset": 26
    },
    {
      "id": "crverdict",
      "label": "CR verdict",
      "sublabel": "review-verdict.sh CR",
      "lane": "lt",
      "type": "external",
      "tag": "SEE: verdict CR",
      "col": 1,
      "width": 150
    },
    {
      "id": "cisig",
      "label": "Red CI \u00b7 DIRTY",
      "sublabel": "checks red \u00b7 mergeState DIRTY",
      "lane": "lt",
      "type": "external",
      "tag": "SEE: red \u00b7 DIRTY",
      "col": 4,
      "width": 195
    }
  ],
  "edges": [
    {
      "from": "issue",
      "to": "devleg",
      "label": "guard pass"
    },
    {
      "from": "devleg",
      "to": "pr",
      "label": "+ai_developed"
    },
    {
      "from": "pr",
      "to": "vfresh",
      "label": "checks none|pending"
    },
    {
      "from": "vfresh",
      "to": "reviewleg",
      "label": "green \u2192 +ai_validated",
      "variant": "emphasis"
    },
    {
      "from": "reviewleg",
      "to": "varmed",
      "label": "APPROVE + green",
      "variant": "emphasis"
    },
    {
      "from": "manual",
      "to": "reworkleg",
      "label": "human label"
    },
    {
      "from": "varmed",
      "to": "merged",
      "label": "green + CLEAN \u2192 merge_pr",
      "variant": "emphasis"
    },
    {
      "from": "crverdict",
      "to": "reworkleg",
      "label": "verdict CR"
    },
    {
      "from": "cisig",
      "to": "failval",
      "label": "checks red"
    },
    {
      "from": "reviewleg",
      "to": "reworkleg",
      "label": "CHANGES_REQUESTED",
      "role": "error"
    },
    {
      "from": "reworkleg",
      "to": "reviewleg",
      "label": "threads resolved \u2192 re-review"
    },
    {
      "from": "reworkleg",
      "to": "vfresh",
      "label": "push \u2192 new head"
    },
    {
      "from": "varmed",
      "to": "failval",
      "label": "checks red (armed)",
      "role": "error"
    },
    {
      "from": "vfresh",
      "to": "failval",
      "label": "checks red",
      "role": "error"
    },
    {
      "from": "failval",
      "to": "reworkleg",
      "label": "+agent:rework (machine)",
      "role": "error"
    },
    {
      "from": "conflict",
      "to": "reworkleg",
      "label": "DIRTY \u2192 +agent:rework",
      "role": "error"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Gate guards \u2014 Levels 1\u20132 (full blocking conditions)",
      "items": [
        "dev leg: issue OPEN \u00b7 \u00acagent:skip \u00b7 assignee ai-teammate or agent:dev \u00b7 fresh handoff only (no status labels yet)",
        "review-after-dev: ai_developed + ai_validated \u00b7 \u00acai_pr_reviewed \u00acpr_approved \u00b7 re-review: ai_pr_reviewed + green + ALL threads resolved + stale verdict \u00b7 \u00acagent:review \u00acai_validating \u00acpr_approved"
      ]
    },
    {
      "dot": "amber",
      "title": "Gate guards \u2014 Levels 3\u20134 (full blocking conditions)",
      "items": [
        "validate-fresh: checks none|pending \u00b7 \u00acai_validating \u00acpr_approved \u00acai_validated \u00acBEHIND \u00b7 validate-armed: pr_approved + mutex ai_validating free (FIFO oldest) \u00b7 \u00acBEHIND",
        "merge-validated: green + CLEAN \u00b7 fail-validation: red (CANCELLED = no verdict) \u00b7 conflict-rework: DIRTY \u00b7 close-on-merge: ai_developed + issue OPEN \u00b7 stalls: factory-stalls.html"
      ]
    }
  ]
}