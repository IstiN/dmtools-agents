          "limit": 1,
          "id": "rework-on-red-ci"
        },
        {
          "description": "GitLab twin of sm_github.json rule 'rework-on-label' — see that rule's description for the operational contract.",
          "source": "gitlab",
          "query": {
            "type": "pr",
            "labels": [
              "agent:rework"
            ]
          },
          "workflowFile": "ai-teammate.yml",
          "inputs": {
            "issue": "",
            "leg": "rework",
