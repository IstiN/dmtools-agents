{
  "name": "JSRunner",
  "params": {
    "jsPath": "js/smAgent.js",
    "jobParams": {
      "maxTriggeredWorkflows": 3,
      "validationConcurrency": 3,
      "validationConcurrencyQueueWatermark": 3,
      "smGuestTransplant": {
        "enabled": false
      },
      "rules": [
        {
          "description": "GitLab twin of sm_github.json rule 'rerun-cancelled-checks' — see that rule's description for the operational contract. Disabled on GitLab: localAction 'rerun_cancelled_checks' still uses GitHub-only tools in js/smAgent.js.",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "labels": [
              "ai_validating",
              "ai_validated"
            ],
            "notLabels": [
              "agent:rework"
            ],
            "notMergeState": [
              "BEHIND",
              "DIRTY"
            ],
            "notMachine": true,
            "draft": false
          },
          "localAction": "rerun_cancelled_checks",
          "requiredContexts": [
            "static",
            "gate",
            "agents-gate"
          ],
          "limit": 2,
          "id": "rerun-cancelled-checks"
        },
        {
          "description": "GitLab twin of sm_github.json rule 'rerun-any-cancelled-checks' — see that rule's description for the operational contract. Disabled on GitLab: localAction 'rerun_cancelled_checks' still uses GitHub-only tools in js/smAgent.js.",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "labels": [
              "ai_validating",
              "ai_validated"
            ],
            "notLabels": [
              "agent:rework"
            ],
            "notMergeState": [
              "BEHIND",
              "DIRTY"
            ],
            "prMachineAuthor": true,
            "draft": false
          },
          "localAction": "rerun_cancelled_checks",
          "anyCancelled": true,
          "limit": 2,
          "id": "rerun-any-cancelled-checks"
        },
        {
          "id": "reconcile-rework-vs-approval",
          "description": "GitLab twin of sm_github.json rule 'reconcile-rework-vs-approval' — see that rule's description for the operational contract. Disabled on GitLab: no GitLab machine verdict records (latestVerdict never matches, notLatestVerdict fails open).",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "labels": [
              "agent:rework"
            ],
            "latestVerdict": [
              "APPROVE"
            ],
            "draft": false
          },
          "localAction": "reconcile_verdicts",
          "limit": 10
        },
        {
          "id": "reconcile-issue-rework-vs-approval",
          "description": "GitLab twin of sm_github.json rule 'reconcile-issue-rework-vs-approval' — see that rule's description for the operational contract. Disabled on GitLab: no GitLab machine verdict records (latestVerdict never matches, notLatestVerdict fails open).",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "issue",
            "labels": [
              "agent:rework"
            ],
            "prState": "OPEN",
            "latestVerdict": [
              "APPROVE"
            ]
          },
          "localAction": "reconcile_verdicts",
          "limit": 10
        },
        {
          "id": "reconcile-approval-vs-changes",
          "description": "GitLab twin of sm_github.json rule 'reconcile-approval-vs-changes' — see that rule's description for the operational contract. Disabled on GitLab: no GitLab machine verdict records (latestVerdict never matches, notLatestVerdict fails open).",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "labels": [
              "pr_approved"
            ],
            "latestVerdict": [
              "REQUEST_CHANGES",
              "BLOCK"
            ],
            "draft": false
          },
          "localAction": "reconcile_verdicts",
          "limit": 10
        },
        {
          "description": "GitLab twin of sm_github.json rule 'unarm-stale-validation' — see that rule's description for the operational contract. Disabled on GitLab: localAction 'unarm_validation' still uses GitHub-only tools in js/smAgent.js.",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "labels": [
              "ai_validating"
            ],
            "mergeState": [
              "BEHIND"
            ],
            "draft": false
          },
          "localAction": "unarm_validation",
          "limit": 1,
          "id": "unarm-stale-validation"
        },
        {
          "description": "GitLab twin of sm_github.json rule 'silent-update-behind' — see that rule's description for the operational contract. Disabled on GitLab: localAction 'update_branch' still uses GitHub-only tools in js/smAgent.js.",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "notLabels": [
              "ai_validating"
            ],
            "mergeState": [
              "BEHIND"
            ],
            "draft": false
          },
          "localAction": "update_branch",
          "limit": 10,
          "id": "silent-update-behind"
        },
        {
          "description": "GitLab twin of sm_github.json rule 'park-reset' — see that rule's description for the operational contract. Disabled on GitLab: localAction 'update_branch' still uses GitHub-only tools in js/smAgent.js.",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "labels": [
              "validation_failed"
            ],
            "notLabels": [
              "ai_validating",
              "blocked"
            ],
            "draft": false
          },
          "localAction": "update_branch",
          "limit": 10,
          "id": "park-reset"
        },
        {
          "description": "GitLab twin of sm_github.json rule 'merge-validated' — see that rule's description for the operational contract. Disabled on GitLab: localAction 'merge_pr' still uses GitHub-only tools in js/smAgent.js.",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "labels": [
              "ai_validating"
            ],
            "checks": "green",
            "mergeState": "CLEAN",
            "notLatestVerdict": [
              "REQUEST_CHANGES",
              "BLOCK"
            ]
          },
          "localAction": "merge_pr",
          "limit": 1,
          "id": "merge-validated"
        },
        {
          "description": "GitLab twin of sm_github.json rule 'merge-validated-guest' — see that rule's description for the operational contract. Disabled on GitLab: localAction 'merge_pr' still uses GitHub-only tools in js/smAgent.js.",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "labels": [
              "ai_validating",
              "pr_approved"
            ],
            "checks": [
              "none",
              "pending"
            ],
            "mergeState": "CLEAN",
            "notMachine": true,
            "notLatestVerdict": [
              "REQUEST_CHANGES",
              "BLOCK"
            ],
            "draft": false
          },
          "localAction": "merge_pr",
          "guestZeroFailing": true,
          "limit": 1,
          "id": "merge-validated-guest"
        },
        {
          "description": "GitLab twin of sm_github.json rule 'fail-validation' — see that rule's description for the operational contract. Disabled on GitLab: localAction 'fail_validation' still uses GitHub-only tools in js/smAgent.js.",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "labels": [
              "ai_validating"
            ],
            "checks": "red"
          },
          "localAction": "fail_validation",
          "limit": 10,
          "id": "fail-validation"
        },
        {
          "description": "GitLab twin of sm_github.json rule 'rework-on-red-gate-unlatched' — see that rule's description for the operational contract. Disabled on GitLab: localAction 'arm_rework' still uses GitHub-only tools in js/smAgent.js.",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "checks": [
              "red"
            ],
            "notLabels": [
              "ai_validating",
              "validation_failed",
              "agent:rework",
              "chore:pin"
            ],
            "prMachineAuthor": true,
            "notMergeState": [
              "BEHIND",
              "DIRTY"
            ],
            "draft": false
          },
          "localAction": "arm_rework",
          "redHeadGated": true,
          "limit": 1,
          "id": "rework-on-red-gate-unlatched"
        },
        {
          "description": "GitLab twin of sm_github.json rule 'rework-on-validation-failed' — see that rule's description for the operational contract. Disabled on GitLab: localAction 'arm_rework' still uses GitHub-only tools in js/smAgent.js.",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "labels": [
              "validation_failed"
            ],
            "notLabels": [
              "agent:rework",
              "ai_validating"
            ],
            "checks": [
              "red"
            ],
            "prMachineAuthor": true,
            "draft": false
          },
          "localAction": "arm_rework",
          "limit": 1,
          "id": "rework-on-validation-failed"
        },
        {
          "description": "GitLab twin of sm_github.json rule 'sweep-stale-validating' — see that rule's description for the operational contract. Disabled on GitLab: localAction 'sweep_stale_validation' still uses GitHub-only tools in js/smAgent.js.",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "labels": [
              "ai_validating"
            ],
            "notMergeState": [
              "BEHIND"
            ],
            "draft": false
          },
          "localAction": "sweep_stale_validation",
          "staleMinutes": 15,
          "limit": 10,
          "id": "sweep-stale-validating"
        },
        {
          "description": "GitLab twin of sm_github.json rule 'validate-armed' — see that rule's description for the operational contract. Disabled on GitLab: localAction 'validate_pr' still uses GitHub-only tools in js/smAgent.js.",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "labels": [
              "pr_approved"
            ],
            "notLabels": [
              "ai_validating",
              "validation_failed",
              "rework-loop-escalated"
            ],
            "notMergeState": [
              "BEHIND",
              "DIRTY"
            ],
            "draft": false,
            "mutex": "ai_validating",
            "mutexAmong": [
              "pr_approved"
            ],
            "notLatestVerdict": [
              "REQUEST_CHANGES",
              "BLOCK"
            ]
          },
          "localAction": "validate_pr",
          "skipIfValidatedHead": true,
          "redHeadSkip": true,
          "limit": 1,
          "id": "validate-armed",
          "deferRedHead": true
        },
        {
          "description": "GitLab twin of sm_github.json rule 'revalidate-armed' — see that rule's description for the operational contract. Disabled on GitLab: localAction 'validate_pr' still uses GitHub-only tools in js/smAgent.js.",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "labels": [
              "pr_approved",
              "ai_validating"
            ],
            "notMergeState": [
              "BEHIND",
              "DIRTY"
            ],
            "checks": [
              "none",
              "pending"
            ],
            "draft": false,
            "mutex": "ai_validating",
            "mutexAmong": [
              "pr_approved"
            ],
            "mutexExcludeSelf": true,
            "notLatestVerdict": [
              "REQUEST_CHANGES",
              "BLOCK"
            ]
          },
          "localAction": "validate_pr",
          "limit": 1,
          "id": "revalidate-armed"
        },
        {
          "description": "GitLab twin of sm_github.json rule 'revalidate-armed-green' — see that rule's description for the operational contract. Disabled on GitLab: localAction 'validate_pr' still uses GitHub-only tools in js/smAgent.js.",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "labels": [
              "pr_approved",
              "ai_validating"
            ],
            "notMergeState": [
              "BEHIND",
              "DIRTY",
              "CLEAN"
            ],
            "checks": [
              "green"
            ],
            "draft": false,
            "mutex": "ai_validating",
            "mutexAmong": [
              "pr_approved"
            ],
            "mutexExcludeSelf": true,
            "notLatestVerdict": [
              "REQUEST_CHANGES",
              "BLOCK"
            ]
          },
          "localAction": "validate_pr",
          "limit": 1,
          "id": "revalidate-armed-green",
          "skipIfGreenCi": true
        },
        {
          "description": "GitLab twin of sm_github.json rule 'validate-fresh' — see that rule's description for the operational contract. Disabled on GitLab: localAction 'validate_pr' still uses GitHub-only tools in js/smAgent.js.",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "checks": [
              "none",
              "pending"
            ],
            "notLabels": [
              "ai_validating",
              "pr_approved",
              "chore:pin"
            ],
            "notMergeState": "BEHIND",
            "draft": false
          },
          "localAction": "validate_pr",
          "limit": 1,
          "id": "validate-fresh"
        },
        {
          "description": "GitLab twin of sm_github.json rule 'validate-fresh-masked-green' — see that rule's description for the operational contract. Disabled on GitLab: localAction 'validate_pr' still uses GitHub-only tools in js/smAgent.js.",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "checks": "green",
            "notLabels": [
              "ai_validating",
              "pr_approved",
              "chore:pin",
              "validation_failed"
            ],
            "notMergeState": [
              "BEHIND",
              "DIRTY"
            ],
            "mergeStateLatch": {
              "CLEAN": [
                "ai_developed"
              ]
            },
            "draft": false
          },
          "localAction": "validate_pr",
          "skipIfGreenCi": true,
          "limit": 1,
          "id": "validate-fresh-masked-green"
        },
        {
          "description": "GitLab twin of sm_github.json rule 'validated-green' — see that rule's description for the operational contract. Disabled on GitLab: localAction 'complete_validation' still uses GitHub-only tools in js/smAgent.js.",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "labels": [
              "ai_validating"
            ],
            "notLabels": [
              "pr_approved"
            ],
            "checks": "green"
          },
          "localAction": "complete_validation",
          "limit": 10,
          "id": "validated-green"
        },
        {
          "id": "guest-transplant",
          "source": "gitlab",
          "enabled": false,
          "guestTransplant": true,
          "description": "GitLab twin of sm_github.json rule 'guest-transplant' — see that rule's description for the operational contract. Disabled on GitLab: guest transplant (smGuestTransplant) is disabled on GitLab.",
          "query": {
            "type": "pr",
            "labels": [
              "po_accept"
            ],
            "notLabels": [
              "agent:rework"
            ],
            "notMachine": true,
            "crossRepo": true,
            "draft": false,
            "allowBlockedItems": true
          },
          "localAction": "transplant_guest_pr",
          "limit": 1
        },
        {
          "description": "GitLab twin of sm_github.json rule 'conflict-rework' — see that rule's description for the operational contract. Disabled on GitLab: localAction 'conflict_rework' still uses GitHub-only tools in js/smAgent.js.",
          "source": "gitlab",
          "enabled": false,
          "query": {
            "type": "pr",
            "mergeState": [
              "DIRTY"
            ],
            "draft": false
          },
          "localAction": "conflict_rework",
          "limit": 5,
          "id": "conflict-rework"
        },
        {
          "description": "GitLab twin of sm_github.json rule 'rework-on-red-ci' — see that rule's description for the operational contract.",
          "source": "gitlab",
          "query": {
            "type": "issue",
            "labels": [
              "agent:rework"
            ],
            "notPrLabels": [
              "agent:rework"
            ],
            "prMachineAuthor": true
          },
          "workflowFile": "ai-teammate.yml",
          "inputs": {
